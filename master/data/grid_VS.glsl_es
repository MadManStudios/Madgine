#version 300 es
#define readonly 
#define buffer uniform
#define std430 std140

struct GridPerFrame
{
    mat4 vp;
    vec3 cameraPos;
};

layout(std140) uniform buffer1
{
    layout(row_major) GridPerFrame frame;
} PerFrame;

layout(location = 0) in vec3 in_var_POSITION0;
layout(location = 1) in float in_var_POSITION1;
out vec4 out_var_POSITION;

mat4 spvWorkaroundRowMajor(mat4 wrap) { return wrap; }

void main()
{
    vec4 _28 = vec4(in_var_POSITION0, in_var_POSITION1);
    gl_Position = _28 * spvWorkaroundRowMajor(PerFrame.frame.vp);
    out_var_POSITION = _28;
}


