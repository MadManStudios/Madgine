MESSAGE(STATUS "Starting APK packaging...")

set(suffix)
if (CMAKE_HOST_WIN32)
	set(suffix ".bat")
endif()

EXECUTE_PROCESS(
	COMMAND gradle${suffix} assembleDebug COMMAND_ERROR_IS_FATAL ANY COMMAND_ECHO STDOUT OUTPUT_STRIP_TRAILING_WHITESPACE
	WORKING_DIRECTORY ${CPACK_TEMPORARY_DIRECTORY}/MadgineLauncher)

EXECUTE_PROCESS(
	COMMAND ${CMAKE_COMMAND} -E copy ${CPACK_TEMPORARY_DIRECTORY}/MadgineLauncher/build/outputs/apk/debug/$<TARGET_FILE_BASE_NAME:MadgineLauncher>.apk ${CPACK_PACKAGE_DIRECTORY}/${CPACK_PACKAGE_FILE_NAME}.apk)

MESSAGE(STATUS "Done")