set(WASM_SPLIT_NAME wasm-split-${CMAKE_HOST_SYSTEM_NAME}-x86_64@HOST_EXECUTABLE_SUFFIX@)

file(DOWNLOAD https://github.com/getsentry/symbolicator/releases/latest/download/${WASM_SPLIT_NAME} ${CPACK_TEMPORARY_DIRECTORY}/${WASM_SPLIT_NAME})
file(CHMOD ${CPACK_TEMPORARY_DIRECTORY}/${WASM_SPLIT_NAME} PERMISSIONS OWNER_EXECUTE GROUP_EXECUTE WORLD_EXECUTE)

execute_process(COMMAND 
	./${WASM_SPLIT_NAME}
	MadgineLauncher/bin/$<TARGET_FILE_BASE_NAME:MadgineLauncher>.wasm
	-o MadgineLauncher/bin/$<TARGET_FILE_BASE_NAME:MadgineLauncher>.wasm
	-d ${CPACK_PACKAGE_DIRECTORY}/$<TARGET_FILE_BASE_NAME:MadgineLauncher>.debug.wasm
	--strip
	WORKING_DIRECTORY ${CPACK_TEMPORARY_DIRECTORY}
	COMMAND_ERROR_IS_FATAL ANY
)

file(ARCHIVE_CREATE
	OUTPUT ${CPACK_PACKAGE_DIRECTORY}/${CPACK_PACKAGE_FILE_NAME}.zip
	PATHS .
    FORMAT "zip"
	WORKING_DIRECTORY ${CPACK_TEMPORARY_DIRECTORY}/MadgineLauncher)