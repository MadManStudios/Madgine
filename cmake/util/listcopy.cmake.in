cmake_policy(SET CMP0057 NEW)

$<TARGET_PROPERTY:copy_data,DATA_TARGETS>


set(filenames)
set(licenses "")

macro(resolve_licenses group path)

	string(REPLACE "/" "_" identifier "${path}")

	set(identifier "CACHE_${group}_${identifier}")

	if (NOT ${identifier})	
		set(license "")
		if (EXISTS ${${group}_SOURCE_DIR}/${path}/LICENSE.txt)
			file(READ ${${group}_SOURCE_DIR}/${path}/LICENSE.txt content)
			set(licenses "${licenses}${content}
			

=================================================
			

			")
			set(license "${${group}_SOURCE_DIR}/${path}/LICENSE.txt")
		elseif(NOT "${path}" STREQUAL "")
			set(local ${path})
			cmake_path(GET local PARENT_PATH parent)
			resolve_licenses(${group} "${parent}")
		endif()
		set(${identifier} ${license})
	else()
		set(license ${identifier})
	endif()

endmacro(resolve_licenses)

foreach(list "$<TARGET_PROPERTY:copy_data,DATA_LISTS>")
	
	message(STATUS "Copying data-list: ${list}")

	file(STRINGS ${list} contents)

	foreach(file ${contents})

		if (file MATCHES "([^:]*):(.*)")

			if (NOT CMAKE_MATCH_1)
				set(path ${CMAKE_MATCH_2})
			elseif (${CMAKE_MATCH_1}_SOURCE_DIR)
				set(path ${${CMAKE_MATCH_1}_SOURCE_DIR}/${CMAKE_MATCH_2})
				cmake_path(GET CMAKE_MATCH_2 PARENT_PATH folder)
				cmake_path(SET folder NORMALIZE "${folder}")
				resolve_licenses(${CMAKE_MATCH_1} "${folder}")
				if (NOT ${license} STREQUAL "")
					MESSAGE(STATUS "Using license ${license} for:")
				endif()
			else ()
				MESSAGE(STATUS "Skipping file ${CMAKE_MATCH_2} in project ${CMAKE_MATCH_1} as source directory is not defined. Plugin is probably disabled.")
				continue()
			endif()

			file(INSTALL ${path} DESTINATION ${TARGET})

			get_filename_component(name ${path} NAME)
			list(APPEND filenames ${name})

		else()
			MESSAGE(SEND_ERROR "Unknown line format in list '${list}': ${file}")
		endif()

	endforeach()

endforeach()

