#include "grid.sl"

cbuffer PerFrame : register( b1 )
{
    GridPerFrame frame;
}


struct PixelShaderInput
{
    float4 pos : SV_Position;
    float4 worldPos : POSITION;
};

float3 _smoothstep(float3 edge0, float3 edge1, float3 x) {
	float3 t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

float4 main( PixelShaderInput IN ) : SV_TARGET
{
	float4 col = float4(0.0,0.0,0.0,0.0);

	float3 coord = IN.worldPos.xyz / 1.0; //square size in world space
	coord /= IN.worldPos.w;
	
	float dist = distance(coord, frame.cameraPos);

	float3 fract = frac(coord); //fractional parts of squares
	//interpolation, grad is smoothness of line gradients
	float3 grad = 0.02 * float3(sqrt(pow(coord.x - frame.cameraPos.x, 2.0) + pow(frame.cameraPos.y, 2.0)), 0.0, sqrt(pow(coord.z - frame.cameraPos.z, 2.0) + pow(frame.cameraPos.y, 2.0))) / abs(frame.cameraPos.y);
	float3 mult = _smoothstep(0.0, grad, fract) - smoothstep(float3(1.0, 1.0, 1.0)-grad, float3(1.0, 1.0, 1.0), fract);
	//col = mix(float4(1.0,1.0,1.0,1.0), vec4(0.0,0.0,0.0,0.0), mult.x * mult.y * mult.z);
	col = float4(0.7, 0.7, 0.7, clamp(1.0 - mult.x * mult.z, 0.0, 1.0) * (1.0 - smoothstep(1.0, 15.0, dist)));	

    return col;
}